# Resolve react_native_pods.rb with node to allow for hoisting
# The RN 0.86 prebuilt frameworks are not propagated to this app target by
# CocoaPods, leaving Folly, glog, and DoubleConversion symbols unresolved.
# Build RN core and its third-party dependencies as pods instead.
ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# --- Phone push (Firebase Cloud Messaging) ---------------------------------------------------
# UNVERIFIED: written without a Mac, never run through `pod install`. @react-native-firebase/app +
# /messaging and @notifee/react-native are autolinked once they are in package.json. Firebase's Swift
# pods need either static frameworks or modular headers:
#   - preferred: install with `USE_FRAMEWORKS=static bundle exec pod install` (the switch above)
#   - if CocoaPods instead reports "The Swift pod `X` depends upon `Y`, which does not define modules",
#     uncomment the modular_headers lines below.
$RNFirebaseAsStaticFramework = true if linkage == 'static'

target 'TrendzoMockup' do
  config = use_native_modules!

  # pod 'GoogleUtilities', :modular_headers => true
  # pod 'FirebaseCore', :modular_headers => true
  # pod 'FirebaseCoreInternal', :modular_headers => true
  # pod 'FirebaseCoreExtension', :modular_headers => true
  # pod 'FirebaseInstallations', :modular_headers => true
  # pod 'GoogleDataTransport', :modular_headers => true
  # pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
