# Copy to .env. react-native-config reads this at native build time.
# API_BASE_URL: leave empty to auto-pick the platform default host, or set an
# explicit LAN URL for a physical device (e.g. http://192.168.1.20:5055).
# NOTE: for a physical device the backend's PUBLIC_BASE_URL must be the SAME
# LAN IP, or the /files/... image URLs it returns won't load on the device.
API_BASE_URL=
API_PORT=5055
MOCK=false
